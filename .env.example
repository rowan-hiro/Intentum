# Copy to .env at the repository root. Values here are names only.

# Required for DataSpace runners (smoke / agent).
# DATASPACE_BENCHMARK=

# Optional. When unset, the champion comparison scorer is skipped.
# KDDCUP_CHAMPION=

# Required for model-driven DataSpace runs.
# DEFAULT_MODEL_API_URL=
# DEFAULT_MODEL_API_KEY=
# DEFAULT_MODEL_NAME=

# Optional local media defaults for the OpenCode host.
# HARNESS_VIDEO=1
# HARNESS_ASR_MODEL=
# HARNESS_OPENCODE_IMAGE=
